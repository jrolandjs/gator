{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "module": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true, // enable all strict type checking options
    "moduleResolution": "Node", // specifies how modules are resolved
    "esModuleInterop": true, // ES module syntax nutzen
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"], // welche werden in Kompilierung einbezogen
  "exclude": ["node_modules"]
}
